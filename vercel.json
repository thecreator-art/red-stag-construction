{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.redstagcc.com"
        }
      ],
      "destination": "https://redstagcc.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.redstagcc.com"
        }
      ],
      "destination": "https://redstagcc.com/:path*",
      "permanent": true
    },
    {
      "source": "/services/home-remodeling",
      "destination": "/general-contractor-los-angeles",
      "permanent": true
    },
    {
      "source": "/services/kitchen-remodeling",
      "destination": "/kitchen-remodel-los-angeles",
      "permanent": true
    },
    {
      "source": "/services/adu-construction",
      "destination": "/adu-contractor-los-angeles",
      "permanent": true
    },
    {
      "source": "/services/bathroom-remodeling",
      "destination": "/bathroom-remodel-los-angeles",
      "permanent": true
    },
    {
      "source": "/services/hardscaping",
      "destination": "/hardscape-contractor-los-angeles",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}